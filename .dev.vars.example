ADMIN_USERNAME=dolbakggom
# Generate a salted PBKDF2 hash with the README command before deploying.
ADMIN_PASSWORD_HASH=pbkdf2:310000:replace-with-salt:replace-with-derived-hash
# Use at least 32 random bytes (64 hexadecimal characters).
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Optional: enables global Cloudflare file purge after admin saves.
CLOUDFLARE_ZONE_ID=replace-with-zone-id
CLOUDFLARE_CACHE_PURGE_TOKEN=replace-with-cache-purge-token

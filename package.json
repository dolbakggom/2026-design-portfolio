{
  "name": "2026-design-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/*.test.ts",
    "test:integration": "npm run build && node --test tests/integration/*.integration.ts",
    "preview": "astro preview",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply portfolio-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply portfolio-db --remote",
    "images:backfill:dry:local": "node scripts/backfill-image-variants.mjs --dry-run --local",
    "images:backfill:dry:remote": "node scripts/backfill-image-variants.mjs --dry-run --remote",
    "images:backfill:apply:remote": "node scripts/backfill-image-variants.mjs --apply --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.3",
    "@astrojs/react": "^6.0.1",
    "@floating-ui/dom": "^1.7.6",
    "@tiptap/extension-image": "^3.8.0",
    "@tiptap/extension-placeholder": "^3.8.0",
    "@tiptap/react": "^3.8.0",
    "@tiptap/starter-kit": "^3.8.0",
    "astro": "^7.0.9",
    "drizzle-orm": "^0.45.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.23",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.17.6",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.1",
    "playwright-core": "^1.61.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.110.0"
  }
}

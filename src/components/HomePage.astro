---
import PublicLayout from "../layouts/PublicLayout.astro";
import { getHomeContent } from "../lib/content";

interface Props {
  initialSection?: "intro" | "about" | "career" | "work";
}

const { initialSection = "intro" } = Astro.props;
const { profile, timeline, featuredWorks, works } = await getHomeContent();
const categories = ["ALL", "UI/UX", "BI/BX"];
const logoSrc = "/assets/figma/hampenta-logo.svg";
const fallbackPortraitSrc = "/assets/figma/profile-guitar.png";
const slogan = profile.headline.replace(/\.$/, "");
const emailLink = profile.links.find((link) => link.url.startsWith("mailto:"));
const phoneLink = profile.links.find((link) => link.url.startsWith("tel:") || /010[-\d]+/.test(link.label));
const locationLink = profile.links.find((link) => link.label.includes("서울") || link.label.toLowerCase() === "location");
const identityTravelSvh = Math.max(210, 126 + timeline.length * 18);
const yearDateTime = (year: string | null | undefined) => year?.match(/\d{4}/)?.[0] ?? "2026";
---

<PublicLayout title={`${profile.headline} | ${profile.name}`} description={profile.bio} htmlClass="home-scroll" bodyClass="home-body">
  <main class="site-shell" data-initial-section={initialSection}>
    <section class="intro-section snap-panel" aria-label="Intro" data-route="/">
      <div class="intro-grid">
        <img class="site-logo intro-logo" src={logoSrc} alt="" />
        <h1 class="intro-title">
          <span data-intro-typewriter={slogan}>{slogan}</span><span class="intro-dot" aria-hidden="true">.</span>
        </h1>
        <div class="intro-scroll-cue" aria-hidden="true">
          <p></p>
        </div>
      </div>
    </section>

    <section class="identity-section snap-panel" id="about" data-identity data-route="/about" style={`min-height:${identityTravelSvh}svh;`}>
      <div class="identity-stage">
        <div class="identity-copy">
          <img class="profile-logo" src={logoSrc} alt="" />
          <div class="identity-copy-stack">
            <div class="profile-intro identity-copy-panel is-active" data-type-copy="about" set:html={profile.intro} />
            <div class="timeline-heading identity-copy-panel" data-type-copy="career">
              <h2>초등학교 방과 후 교실에서 포토샵에 흥미를 가진 이후,<br />2014년부터 계속 활동하고 있습니다.</h2>
            </div>
          </div>
          <div class="profile-contact" data-profile-contact>
            <strong>{profile.name}</strong>
            {emailLink ? <a href={emailLink.url}><img src="/assets/figma/email.svg" alt="" aria-hidden="true" />{emailLink.label}</a> : null}
            {phoneLink ? <a href={phoneLink.url}><img src="/assets/figma/phone.svg" alt="" aria-hidden="true" />{phoneLink.label}</a> : null}
            {locationLink ? <span><img src="/assets/figma/mappin.svg" alt="" aria-hidden="true" />{locationLink.label}</span> : null}
          </div>
        </div>

        <div class="identity-side">
          <figure class="profile-media" data-profile-media>
            <img src={profile.portrait?.url ?? fallbackPortraitSrc} alt={profile.portrait?.alt ?? profile.name} />
            <figcaption>취미로 기타를 치고 있습니다.</figcaption>
          </figure>

          <div class="timeline-items" data-career-list>
            {
              timeline.map((item, index) => (
                <article class:list={["timeline-card", index === 0 && "is-active"]} data-timeline-card>
                  <p>{item.period}</p>
                  <h3>{item.title}</h3>
                  <span>{item.organization}</span>
                  <div>{item.description}</div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="work-intro-section snap-panel" id="work" aria-label="Work intro" data-route="/work">
      <img class="site-logo" src={logoSrc} alt="" />
      <h2>WORK</h2>
    </section>

    <section class="featured-section" id="featured-work" data-route="/work">
      <div class="featured-stage">
        <div class="section-heading">
          <p class="section-kicker">Selected Work</p>
        </div>
        <div class="featured-list">
          {
            featuredWorks.map((work, index) => (
              <article class:list={["featured-work", index === 0 && "is-active"]} style={`--work-index:${index};`} data-featured-panel data-route="/work">
                <div class="featured-link">
                  <div class="work-visual">
                    {work.featuredThumbnail?.url || work.thumbnail?.url ? (
                      <img
                        src={work.featuredThumbnail?.url ?? work.thumbnail?.url}
                        alt={work.featuredThumbnail?.alt ?? work.thumbnail?.alt ?? work.title}
                        crossorigin="anonymous"
                        loading="lazy"
                        transition:name={`featured-media-${work.slug}`}
                      />
                    ) : null}
                  </div>
                  <div class="featured-copy">
                    <span class="featured-category">{work.category}</span>
                    <h3>{work.title}</h3>
                    <p class="featured-meta">
                      <time datetime={yearDateTime(work.year)}>{work.year}</time>
                      <span>{work.client || "개인 프로젝트"}</span>
                      <span>{work.role || "Figma + Adobe Illustrator"}</span>
                    </p>
                    <a href={`/work/${work.slug}`} class="featured-more" aria-label={`${work.title} 자세히 보기`}>더 알아보기</a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
        {
          featuredWorks.length > 1 ? (
            <div class="featured-dots" aria-hidden="true">
              {featuredWorks.map((_, index) => <span class:list={[index === 0 && "is-active"]} data-featured-dot />)}
            </div>
          ) : null
        }
      </div>
      <div class="featured-steps" aria-hidden="true">
        {featuredWorks.map((_, index) => <div class="featured-step snap-panel" data-featured-step data-featured-index={index} data-route="/work" />)}
      </div>
    </section>

    <section class="gallery-section snap-panel" aria-label="Work gallery" data-route="/work">
      <div class="gallery-canvas">
        <div class="section-heading gallery-heading">
          <div class="category-filter" role="tablist" aria-label="Work category">
            {categories.map((category) => <button type="button" class:list={[category === "ALL" && "is-active"]} data-filter={category}>{category}</button>)}
          </div>
        </div>
        <div class="work-grid">
          {
            works.map((work) => (
              <a class="work-tile" href={`/work/${work.slug}`} data-category={work.category} aria-label={`${work.title} 자세히 보기`}>
                <div
                  class:list={["work-tile-media", work.thumbnail?.url && "has-image"]}
                  style={work.thumbnail?.url ? `--tile-image: url("${work.thumbnail.url}")` : undefined}
                  aria-label={work.thumbnail?.alt ?? work.title}
                  role="img"
                />
                <div>
                  <h3>{work.title}</h3>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { ScrollToPlugin } from "gsap/ScrollToPlugin";

    gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);

    let activeHomeShell: HTMLElement | null = null;
    let cleanupHomePage = () => {};

    const initHomePage = () => {
      const shell = document.querySelector<HTMLElement>(".site-shell");
      if (shell && shell === activeHomeShell) return;

      cleanupHomePage();

      if (!shell) {
        activeHomeShell = null;
        document.documentElement.classList.remove("intro-complete", "is-free-scroll");
        return;
      }

      activeHomeShell = shell;
      const pageController = new AbortController();
      const pageSignal = pageController.signal;
      const homeScrollTriggers: ScrollTrigger[] = [];
      let lockedUntil = 0;
      let snapTween: gsap.core.Tween | null = null;
      let snapObserver: ReturnType<typeof ScrollTrigger.observe> | null = null;
      let snapSyncFrame = 0;
      let initialScrollFrame = 0;
      let initialScrollTimeout = 0;
      const portfolioWindow = window as Window & { __portfolioScrollToTop?: () => void };
      let scrollToTopHandler: (() => void) | null = null;
      let programmaticTopScroll = false;
      let restoreTopScrollSnap = () => {};

      cleanupHomePage = () => {
        if (scrollToTopHandler && portfolioWindow.__portfolioScrollToTop === scrollToTopHandler) {
          delete portfolioWindow.__portfolioScrollToTop;
        }
        restoreTopScrollSnap();
        programmaticTopScroll = false;
        pageController.abort();
        window.cancelAnimationFrame(snapSyncFrame);
        window.cancelAnimationFrame(initialScrollFrame);
        if (initialScrollTimeout) {
          window.clearTimeout(initialScrollTimeout);
        }
        snapTween?.kill();
        snapObserver?.kill();
        homeScrollTriggers.forEach((trigger) => trigger.kill());
        document.documentElement.classList.remove("intro-complete", "is-free-scroll");
        activeHomeShell = null;
        cleanupHomePage = () => {};
      };

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const initialSection = shell.dataset.initialSection ?? "intro";
    let preserveWorkRoute = initialSection === "work";

    const replaceRoute = (route: string) => {
      if (window.location.pathname === route) return;
      window.history.replaceState(null, "", route);
    };

    const clearHomeRoute = () => {
      if (preserveWorkRoute) {
        replaceRoute("/work");
        return;
      }

      const gallery = document.querySelector<HTMLElement>(".gallery-section");
      if (gallery && window.scrollY >= gallery.offsetTop - 10) {
        replaceRoute("/work");
        return;
      }

      if (["/about", "/career", "/work"].includes(window.location.pathname)) {
        replaceRoute("/");
      }
    };

    const lockScroll = (duration = 1050) => {
      lockedUntil = Math.max(lockedUntil, Date.now() + duration);
    };

    const isScrollLocked = () => Date.now() < lockedUntil || Boolean(snapTween);

    const typeText = (target: HTMLElement, value: string, speed = 58, done?: () => void) => {
      target.textContent = "";
      const chars = value.split("");
      chars.forEach((char, index) => {
        window.setTimeout(() => {
          target.textContent += char;
          if (index === chars.length - 1) done?.();
        }, speed * index);
      });
    };

    const textCopies = new Map<HTMLElement, { node: Text; text: string }[]>();

    const prepareTypeElement = (element: HTMLElement) => {
      const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT);
      const nodes: { node: Text; text: string }[] = [];
      let current = walker.nextNode();

      while (current) {
        if (current.textContent?.trim()) {
          nodes.push({ node: current as Text, text: current.textContent });
        }
        current = walker.nextNode();
      }

      textCopies.set(element, nodes);
      nodes.forEach(({ node }) => {
        node.textContent = "";
      });
    };

    const typeElement = (element: HTMLElement, speed = 18) => {
      const nodes = textCopies.get(element);
      if (!nodes || element.dataset.typed === "true") return;

      element.dataset.typed = "true";
      let nodeIndex = 0;
      let charIndex = 0;

      const step = () => {
        const current = nodes[nodeIndex];
        if (!current) return;

        current.node.textContent = current.text.slice(0, charIndex + 1);
        charIndex += 1;

        if (charIndex >= current.text.length) {
          nodeIndex += 1;
          charIndex = 0;
        }

        if (nodeIndex < nodes.length) {
          window.setTimeout(step, speed);
        }
      };

      step();
    };

    const introLogo = document.querySelector<HTMLElement>(".intro-logo");
    const introTypeTarget = document.querySelector<HTMLElement>("[data-intro-typewriter]");

    if (introTypeTarget && !reduceMotion) {
      const phrase = introTypeTarget.dataset.introTypewriter ?? introTypeTarget.textContent ?? "";
      introTypeTarget.textContent = "";
      gsap.set(introLogo, { autoAlpha: 0, filter: "blur(18px)", scale: 0.94 });
      gsap.to(introLogo, { autoAlpha: 1, filter: "blur(0px)", scale: 1, duration: 1.45, ease: "power3.out" });
      gsap.delayedCall(1, () => {
        typeText(introTypeTarget, phrase, 64, () => {
          document.documentElement.classList.add("intro-complete");
        });
      });
    } else {
      document.documentElement.classList.add("intro-complete");
    }

    const aboutCopy = document.querySelector<HTMLElement>('[data-type-copy="about"]');
    const careerCopy = document.querySelector<HTMLElement>('[data-type-copy="career"]');
    const identity = document.querySelector<HTMLElement>("[data-identity]");
    const profileLogo = document.querySelector<HTMLElement>(".profile-logo");
    const profileContact = document.querySelector<HTMLElement>("[data-profile-contact]");
    const profileMedia = document.querySelector<HTMLElement>("[data-profile-media]");
    const careerList = document.querySelector<HTMLElement>("[data-career-list]");
    const timelineCards = gsap.utils.toArray<HTMLElement>("[data-timeline-card]");
    const featuredPanels = gsap.utils.toArray<HTMLElement>("[data-featured-panel]");
    const featuredDots = gsap.utils.toArray<HTMLElement>("[data-featured-dot]");

    if (!reduceMotion) {
      [aboutCopy, careerCopy].forEach((element) => {
        if (element) prepareTypeElement(element);
      });

      gsap.set([profileLogo, profileContact, profileMedia], { autoAlpha: 0 });
      gsap.set(profileLogo, { y: 18, filter: "brightness(0) blur(12px)" });
      gsap.set(profileContact, { y: 24 });
      gsap.set(profileMedia, { clipPath: "inset(10% 0% 10% 100%)", scale: 1.08, filter: "blur(10px)" });
      gsap.set(careerList, { autoAlpha: 0, x: 64, filter: "blur(12px)" });
    }

    const playAboutIntro = () => {
      if (!identity || !profileLogo || !profileContact || !profileMedia || !aboutCopy) return;
      if (identity.dataset.aboutPlayed === "true") return;
      if (reduceMotion) return;

      identity.dataset.aboutPlayed = "true";
      const timeline = gsap.timeline();
      timeline
        .to(profileLogo, { autoAlpha: 1, y: 0, filter: "brightness(0) blur(0px)", duration: 0.72, ease: "power3.out" })
        .add(() => typeElement(aboutCopy, 24), "-=0.06")
        .to(profileMedia, { autoAlpha: 1, clipPath: "inset(0% 0% 0% 0%)", scale: 1, filter: "blur(0px)", duration: 1.12, ease: "power4.out" }, "<")
        .to(profileContact, { autoAlpha: 1, y: 0, duration: 0.62, ease: "power3.out" }, "+=0.24");
    };

    let activeTimelineIndex = -1;
    let careerItemLockedUntil = 0;
    const careerItemLockDuration = 360;

    const setIdentityMode = (mode: "about" | "career", progress = 0) => {
      if (!identity) return;
      const isCareer = mode === "career";
      identity.classList.toggle("is-career", isCareer);

      if (isCareer && careerCopy) {
        typeElement(careerCopy, 24);
      }

      if (timelineCards.length) {
        const activeIndex = Math.min(timelineCards.length - 1, Math.max(0, Math.floor(progress * timelineCards.length)));
        if (isCareer && activeTimelineIndex !== -1 && activeIndex !== activeTimelineIndex) {
          careerItemLockedUntil = Date.now() + careerItemLockDuration;
        }
        activeTimelineIndex = activeIndex;
        timelineCards.forEach((card, index) => card.classList.toggle("is-active", index === activeIndex));
      }
    };

    const careerStartProgress = 0.38;
    const careerEndProgress = 0.92;

    const setActiveFeatured = (activeIndex: number) => {
      featuredPanels.forEach((panel, index) => {
        panel.classList.toggle("is-active", index === activeIndex);
      });
      featuredDots.forEach((dot, index) => {
        dot.classList.toggle("is-active", index === activeIndex);
      });
    };

    if (identity && !reduceMotion) {
      homeScrollTriggers.push(ScrollTrigger.create({
        trigger: identity,
        start: "top top",
        end: "bottom bottom",
        scrub: true,
        onEnter: playAboutIntro,
        onEnterBack: playAboutIntro,
        onUpdate: (self) => {
          const showCareer = self.progress >= careerStartProgress * 0.92;
          const careerProgress = gsap.utils.clamp(0, 1, (self.progress - careerStartProgress) / (careerEndProgress - careerStartProgress));
          setIdentityMode(showCareer ? "career" : "about", careerProgress);
          gsap.to(careerList, {
            autoAlpha: showCareer ? 1 : 0,
            x: showCareer ? 0 : 64,
            filter: showCareer ? "blur(0px)" : "blur(12px)",
            duration: 0.26,
            overwrite: true
          });
        }
      }));
    }

    if (!reduceMotion) {
      gsap.utils.toArray<HTMLElement>(".snap-panel").forEach((panel) => {
        homeScrollTriggers.push(ScrollTrigger.create({
          trigger: panel,
          start: "top center",
          end: "bottom center",
          onEnter: () => panel.matches(".gallery-section") ? replaceRoute("/work") : clearHomeRoute(),
          onEnterBack: () => panel.matches(".gallery-section") ? replaceRoute("/work") : clearHomeRoute()
        }));
      });

      gsap.utils.toArray<HTMLElement>("[data-featured-step]").forEach((step, index) => {
        homeScrollTriggers.push(ScrollTrigger.create({
          trigger: step,
          start: "top center",
          end: "bottom center",
          onEnter: () => setActiveFeatured(index),
          onEnterBack: () => setActiveFeatured(index)
        }));
      });
    }

    type SnapTarget = {
      y: number;
      route: string;
      kind: "intro" | "about" | "careerEntry" | "career" | "work" | "featured" | "gallery";
      featuredIndex?: number;
    };

    const snapTolerance = 10;
    const snapLockDuration = 760;
    const aboutLockDuration = 760;
    const snapDuration = 0.74;

    const getIdentityTop = () => document.querySelector<HTMLElement>("[data-identity]")?.offsetTop ?? Number.POSITIVE_INFINITY;
    const getWorkTop = () => document.querySelector<HTMLElement>("#work")?.offsetTop ?? Number.POSITIVE_INFINITY;
    const getFeaturedTop = () => document.querySelector<HTMLElement>("#featured-work")?.offsetTop ?? Number.POSITIVE_INFINITY;
    const getFirstFeaturedTop = getFeaturedTop;
    const getGalleryTop = () => document.querySelector<HTMLElement>(".gallery-section")?.offsetTop ?? Number.POSITIVE_INFINITY;
    const getIdentityProgressRange = () => Math.max(1, getWorkTop() - getIdentityTop() - window.innerHeight);
    const getCareerEntryTop = () => getIdentityTop() + getIdentityProgressRange() * careerStartProgress;
    const getCareerExitTop = () => getIdentityTop() + getIdentityProgressRange() * careerEndProgress;
    const isFreeScrollRange = () => window.scrollY >= getGalleryTop() - snapTolerance;
    const isNativeCareerRange = () => window.scrollY >= getCareerEntryTop() - snapTolerance && window.scrollY <= getCareerExitTop() + snapTolerance;
    const isCareerItemInputLocked = () => !snapTween && isNativeCareerRange() && Date.now() < careerItemLockedUntil;

    const getSnapTargets = () => {
      const intro = document.querySelector<HTMLElement>(".intro-section");
      const identitySection = document.querySelector<HTMLElement>("[data-identity]");
      const workSection = document.querySelector<HTMLElement>("#work");
      const featuredSection = document.querySelector<HTMLElement>("#featured-work");
      const gallery = document.querySelector<HTMLElement>(".gallery-section");
      const targets: SnapTarget[] = [];

      if (intro) targets.push({ y: intro.offsetTop, route: "/", kind: "intro" });
      if (identitySection) {
        targets.push({ y: identitySection.offsetTop, route: "/about", kind: "about" });
        targets.push({ y: getCareerEntryTop(), route: "/career", kind: "careerEntry" });
        targets.push({ y: getCareerExitTop(), route: "/career", kind: "career" });
      }
      if (workSection) targets.push({ y: workSection.offsetTop, route: "/work", kind: "work" });
      if (featuredSection) {
        featuredPanels.forEach((_, index) => {
          targets.push({
            y: featuredSection.offsetTop + window.innerHeight * index,
            route: "/work",
            kind: "featured",
            featuredIndex: index
          });
        });
      }
      if (gallery) targets.push({ y: gallery.offsetTop, route: "/work", kind: "gallery" });

      return targets.sort((a, b) => a.y - b.y);
    };

    const getNextSnapTarget = (targets: SnapTarget[], direction: 1 | -1) => {
      const currentY = window.scrollY;
      const careerTarget = targets.find((target) => target.kind === "career");

      if (
        direction < 0 &&
        careerTarget &&
        currentY > getWorkTop() + snapTolerance &&
        currentY < getFirstFeaturedTop() - snapTolerance
      ) {
        return careerTarget;
      }

      if (direction > 0) {
        return targets.find((target) => target.y > currentY + snapTolerance) ?? null;
      }
      return [...targets].reverse().find((target) => target.y < currentY - snapTolerance) ?? null;
    };

    const applySnapState = (target: SnapTarget) => {
      if (target.kind === "gallery") {
        replaceRoute(target.route);
      } else {
        clearHomeRoute();
      }

      if (target.kind === "featured") {
        setActiveFeatured(target.featuredIndex ?? 0);
      }

      if (target.kind === "about") {
        setIdentityMode("about", 0);
        if (identity?.dataset.aboutPlayed === "true") {
          if (profileLogo) {
            gsap.set(profileLogo, { autoAlpha: 1, y: 0, filter: "brightness(0) blur(0px)" });
          }
          if (profileContact) {
            gsap.set(profileContact, { autoAlpha: 1, y: 0, filter: "blur(0px)" });
          }
          if (profileMedia) {
            gsap.set(profileMedia, { autoAlpha: 1, clipPath: "inset(0% 0% 0% 0%)", scale: 1, filter: "blur(0px)" });
          }
          if (careerList) {
            gsap.to(careerList, { autoAlpha: 0, x: 64, filter: "blur(12px)", duration: 0.25, overwrite: true });
          }
        } else {
          playAboutIntro();
        }
      }

      if (target.kind === "careerEntry" || target.kind === "career") {
        if (identity) {
          identity.dataset.aboutPlayed = "true";
        }
        if (profileLogo) {
          gsap.set(profileLogo, { autoAlpha: 1, y: 0, filter: "brightness(0) blur(0px)" });
        }
        if (profileContact) {
          gsap.set(profileContact, { autoAlpha: 0, y: 24 });
        }
        if (profileMedia) {
          gsap.set(profileMedia, { autoAlpha: 1, clipPath: "inset(0% 0% 0% 0%)", scale: 1, filter: "blur(0px)" });
        }
        if (careerList) {
          gsap.set(careerList, { autoAlpha: 1, x: 0, filter: "blur(0px)" });
        }
        setIdentityMode("career", target.kind === "careerEntry" ? 0 : 0.999);
      }
    };

    const shouldSnapInput = () => !isFreeScrollRange() && !isNativeCareerRange();
    let requestSnapObserverSync = () => {};

    const findSnapTarget = (kind: SnapTarget["kind"]) => getSnapTargets().find((target) => target.kind === kind);

    const snapToTarget = (target: SnapTarget) => {
      if (isScrollLocked()) return;

      lockScroll(target.kind === "about" ? aboutLockDuration : snapLockDuration);
      snapTween = gsap.to(window, {
        scrollTo: { y: Math.round(target.y), autoKill: false },
        duration: snapDuration,
        ease: "power3.inOut",
        overwrite: true,
        onStart: () => {
          if (target.kind === "featured") {
            applySnapState(target);
          }
        },
        onComplete: () => {
          snapTween = null;
          applySnapState(target);
          ScrollTrigger.refresh();
          requestSnapObserverSync();
        },
        onInterrupt: () => {
          snapTween = null;
          requestSnapObserverSync();
        }
      });
    };

    const scrollToIntroFromFloatingButton = () => {
      const target = findSnapTarget("intro") ?? { y: 0, route: "/", kind: "intro" as const };
      const duration = reduceMotion ? 0 : 1.05;
      const html = document.documentElement;
      const body = document.body;
      const previousHtmlSnap = html.style.scrollSnapType;
      const previousBodySnap = body.style.scrollSnapType;

      preserveWorkRoute = false;
      programmaticTopScroll = true;
      careerItemLockedUntil = 0;
      lockedUntil = 0;
      snapTween?.kill();
      snapTween = null;
      snapObserver?.disable();
      html.classList.remove("is-free-scroll");
      html.style.scrollSnapType = "none";
      body.style.scrollSnapType = "none";
      replaceRoute("/");

      restoreTopScrollSnap = () => {
        html.style.scrollSnapType = previousHtmlSnap;
        body.style.scrollSnapType = previousBodySnap;
        restoreTopScrollSnap = () => {};
      };

      const finishTopScroll = () => {
        snapTween = null;
        programmaticTopScroll = false;
        restoreTopScrollSnap();
        applySnapState(target);
        replaceRoute("/");
        lockedUntil = Date.now() + 180;
        ScrollTrigger.refresh();
        requestSnapObserverSync();
      };

      snapTween = gsap.to(window, {
        scrollTo: { y: Math.round(target.y), autoKill: false },
        duration,
        ease: "power3.inOut",
        overwrite: true,
        onComplete: finishTopScroll,
        onInterrupt: () => {
          snapTween = null;
          programmaticTopScroll = false;
          restoreTopScrollSnap();
          requestSnapObserverSync();
        }
      });
    };

    scrollToTopHandler = scrollToIntroFromFloatingButton;
    portfolioWindow.__portfolioScrollToTop = scrollToIntroFromFloatingButton;

    const goToSnap = (direction: 1 | -1) => {
      const targets = getSnapTargets();
      if (!targets.length || programmaticTopScroll || isScrollLocked() || !shouldSnapInput()) return;

      const target = getNextSnapTarget(targets, direction);
      if (!target) return;

      snapToTarget(target);
    };

    const snapAcrossBoundaries = (direction: 1 | -1, event?: Event) => {
      const currentY = window.scrollY;
      const aboutTarget = findSnapTarget("about");
      const careerTarget = findSnapTarget("career");
      const workTarget = findSnapTarget("work");

      // Career -> Work (Down)
      if (
        direction > 0 &&
        workTarget &&
        currentY >= getCareerExitTop() - snapTolerance * 2 &&
        currentY < getWorkTop() - snapTolerance
      ) {
        event?.preventDefault();
        snapToTarget(workTarget);
        return true;
      }

      // Work -> Career (Up)
      if (
        direction < 0 &&
        careerTarget &&
        currentY >= getWorkTop() - snapTolerance &&
        currentY < getFirstFeaturedTop() - snapTolerance
      ) {
        event?.preventDefault();
        snapToTarget(careerTarget);
        return true;
      }

      // CareerEntry -> About (Up)
      if (
        direction < 0 &&
        aboutTarget &&
        currentY <= getCareerEntryTop() + snapTolerance * 2 &&
        currentY > getIdentityTop() + snapTolerance
      ) {
        event?.preventDefault();
        snapToTarget(aboutTarget);
        return true;
      }

      return false;
    };

    const dispatchNativeSnapInput = (direction: 1 | -1, event?: Event) => {
      if (programmaticTopScroll || isScrollLocked() || isCareerItemInputLocked()) {
        event?.preventDefault();
        return;
      }
      if (snapAcrossBoundaries(direction, event)) return;
      if (!shouldSnapInput()) return;

      event?.preventDefault();
      goToSnap(direction);
    };

    if (!reduceMotion) {
      snapObserver = ScrollTrigger.observe({
        target: window,
        type: "wheel,touch",
        wheelSpeed: -1,
        tolerance: 28,
        preventDefault: true,
        onUp: () => goToSnap(1),
        onDown: () => goToSnap(-1)
      });

      let previousScrollY = window.scrollY;
      const syncSnapObserver = () => {
        const currentY = window.scrollY;

        if (programmaticTopScroll) {
          document.documentElement.classList.remove("is-free-scroll");
          if (snapObserver?.isEnabled) snapObserver.disable();
          previousScrollY = currentY;
          return;
        }

        const movedDown = currentY > previousScrollY;
        const freeScroll = isFreeScrollRange();
        const shouldAutoSnapToWork =
          !snapTween &&
          Date.now() >= lockedUntil &&
          movedDown &&
          currentY >= getCareerExitTop() - snapTolerance &&
          previousScrollY < getWorkTop() - snapTolerance;
        const shouldAutoSnapToCareer =
          !snapTween &&
          Date.now() >= lockedUntil &&
          currentY < previousScrollY &&
          previousScrollY > getWorkTop() + snapTolerance &&
          previousScrollY < getFirstFeaturedTop() - snapTolerance &&
          currentY <= getWorkTop() + snapTolerance;
        const shouldAutoSnapToCareerEntry =
          !snapTween &&
          Date.now() >= lockedUntil &&
          movedDown &&
          currentY >= getIdentityTop() + snapTolerance &&
          previousScrollY < getCareerEntryTop() - snapTolerance;
        const shouldAutoSnapToAbout =
          !snapTween &&
          Date.now() >= lockedUntil &&
          currentY < previousScrollY &&
          previousScrollY >= getCareerEntryTop() - snapTolerance &&
          currentY < getCareerEntryTop() - snapTolerance;

        document.documentElement.classList.toggle("is-free-scroll", freeScroll);

        if (snapTween || shouldSnapInput()) {
          if (snapObserver && !snapObserver.isEnabled) snapObserver.enable();
        } else if (snapObserver?.isEnabled) {
          snapObserver.disable();
        }

        previousScrollY = currentY;

        if (shouldAutoSnapToWork) {
          const workTarget = findSnapTarget("work");
          if (workTarget) {
            window.requestAnimationFrame(() => snapToTarget(workTarget));
          }
        }

        if (shouldAutoSnapToCareer) {
          const careerTarget = findSnapTarget("career");
          if (careerTarget) {
            window.requestAnimationFrame(() => snapToTarget(careerTarget));
          }
        }

        if (shouldAutoSnapToCareerEntry) {
          const entryTarget = findSnapTarget("careerEntry");
          if (entryTarget) {
            window.requestAnimationFrame(() => snapToTarget(entryTarget));
          }
        }

        if (shouldAutoSnapToAbout) {
          const aboutTarget = findSnapTarget("about");
          if (aboutTarget) {
            window.requestAnimationFrame(() => snapToTarget(aboutTarget));
          }
        }
      };

      requestSnapObserverSync = () => {
        window.cancelAnimationFrame(snapSyncFrame);
        snapSyncFrame = window.requestAnimationFrame(syncSnapObserver);
      };

      window.addEventListener("scroll", requestSnapObserverSync, { passive: true, signal: pageSignal });
      window.addEventListener("resize", requestSnapObserverSync, { signal: pageSignal });
      requestSnapObserverSync();

      window.addEventListener(
        "wheel",
        (event) => {
          if (Math.abs(event.deltaY) < 4) return;
          if (programmaticTopScroll) {
            event.preventDefault();
            return;
          }
          if (isCareerItemInputLocked()) {
            event.preventDefault();
            return;
          }
          dispatchNativeSnapInput(event.deltaY > 0 ? 1 : -1, event);
        },
        { passive: false, capture: true, signal: pageSignal }
      );

      let touchStartY = 0;
      let touchHandled = false;
      window.addEventListener(
        "touchstart",
        (event) => {
          touchStartY = event.touches[0]?.clientY ?? 0;
          touchHandled = false;
        },
        { passive: true, capture: true, signal: pageSignal }
      );
      window.addEventListener(
        "touchmove",
        (event) => {
          if (touchHandled) return;
          const currentTouchY = event.touches[0]?.clientY ?? touchStartY;
          const deltaY = touchStartY - currentTouchY;
          if (Math.abs(deltaY) < 24) return;
          if (programmaticTopScroll) {
            event.preventDefault();
            return;
          }
          if (isCareerItemInputLocked()) {
            event.preventDefault();
            return;
          }

          touchHandled = true;
          dispatchNativeSnapInput(deltaY > 0 ? 1 : -1, event);
        },
        { passive: false, capture: true, signal: pageSignal }
      );

      window.addEventListener("keydown", (event) => {
        if (event.metaKey || event.ctrlKey || event.altKey) return;
        if (programmaticTopScroll && ["ArrowDown", "PageDown", " ", "ArrowUp", "PageUp"].includes(event.key)) {
          event.preventDefault();
          return;
        }
        if (isCareerItemInputLocked() && ["ArrowDown", "PageDown", " ", "ArrowUp", "PageUp"].includes(event.key)) {
          event.preventDefault();
          return;
        }
        if (!shouldSnapInput()) return;
        if (["ArrowDown", "PageDown", " "].includes(event.key)) {
          event.preventDefault();
          goToSnap(1);
        }
        if (["ArrowUp", "PageUp"].includes(event.key)) {
          event.preventDefault();
          goToSnap(-1);
        }
      }, { signal: pageSignal });
    }

    const scrollToInitialSection = () => {
      if (initialSection === "intro") return;

      const identitySection = document.querySelector<HTMLElement>("[data-identity]");
      const workSection = document.querySelector<HTMLElement>("#work");
      const gallerySection = document.querySelector<HTMLElement>(".gallery-section");
      const targetTop =
        initialSection === "work"
          ? gallerySection?.offsetTop ?? workSection?.offsetTop
          : identitySection
            ? initialSection === "career"
              ? getCareerEntryTop()
              : identitySection.offsetTop
            : 0;

      window.scrollTo({ top: targetTop ?? 0, behavior: "instant" as ScrollBehavior });
      if (initialSection === "work") {
        replaceRoute("/work");
        document.documentElement.classList.add("is-free-scroll");
      }
      if (initialSection === "about") {
        playAboutIntro();
      }
      if (initialSection === "career") {
        if (identity) {
          identity.dataset.aboutPlayed = "true";
        }
        if (profileLogo) {
          gsap.set(profileLogo, { autoAlpha: 1, y: 0, filter: "brightness(0) blur(0px)" });
        }
        if (profileMedia) {
          gsap.set(profileMedia, { autoAlpha: 1, clipPath: "inset(0% 0% 0% 0%)", scale: 1, filter: "blur(0px)" });
        }
        if (careerList) {
          gsap.set(careerList, { autoAlpha: 1, x: 0, filter: "blur(0px)" });
        }
        setIdentityMode("career", 0);
      }
      ScrollTrigger.refresh();
      if (initialSection === "work") {
        window.requestAnimationFrame(() => replaceRoute("/work"));
      }
    };

    initialScrollFrame = window.requestAnimationFrame(() => {
      initialScrollTimeout = window.setTimeout(scrollToInitialSection, 120);
    });

    const updateFeaturedContrast = () => {
      document.querySelectorAll<HTMLElement>(".featured-work").forEach((card) => {
        const img = card.querySelector<HTMLImageElement>(".work-visual img");
        if (!img) {
          card.dataset.textTone = "light";
          return;
        }

        const sampleImage = () => {
          try {
            const canvas = document.createElement("canvas");
            const size = 32;
            canvas.width = size;
            canvas.height = size;
            const context = canvas.getContext("2d", { willReadFrequently: true });
            if (!context) return;

            context.drawImage(img, 0, 0, size, size);
            const pixels = context.getImageData(0, 0, size, size).data;
            let total = 0;
            let count = 0;

            for (let index = 0; index < pixels.length; index += 4) {
              const alpha = pixels[index + 3] / 255;
              if (alpha < 0.2) continue;
              const red = pixels[index];
              const green = pixels[index + 1];
              const blue = pixels[index + 2];
              total += (0.2126 * red + 0.7152 * green + 0.0722 * blue) * alpha;
              count += alpha;
            }

            const luminance = count ? total / count : 0;
            card.dataset.textTone = luminance > 148 ? "dark" : "light";
          } catch {
            card.dataset.textTone = "light";
          }
        };

        if (img.complete && img.naturalWidth) {
          sampleImage();
        } else {
          img.addEventListener("load", sampleImage, { once: true, signal: pageSignal });
          img.addEventListener("error", () => {
            card.dataset.textTone = "light";
          }, { once: true, signal: pageSignal });
        }
      });
    };

    updateFeaturedContrast();

    const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const tiles = document.querySelectorAll<HTMLElement>("[data-category]");

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter ?? "ALL";
        filterButtons.forEach((item) => item.classList.toggle("is-active", item === button));
        tiles.forEach((tile) => {
          tile.toggleAttribute("hidden", filter !== "ALL" && tile.dataset.category !== filter);
        });
      }, { signal: pageSignal });
    });

    };

    document.addEventListener("astro:before-swap", () => cleanupHomePage());
    document.addEventListener("astro:page-load", initHomePage);
    initHomePage();
  </script>
</PublicLayout>

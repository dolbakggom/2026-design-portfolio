---
import PublicLayout from "../layouts/PublicLayout.astro";
import { sanitizeProfileIntro } from "../lib/content-sanitizer";
import { getHomeContentResult } from "../lib/content";
import { applyPublicContentStatus } from "../lib/content-response";
import { buildResponsiveImageSource } from "../lib/responsive-images";
import { createHomeStructuredData } from "../lib/seo";

interface Props {
  initialSection?: "intro" | "about" | "career" | "work";
}

const { initialSection = "intro" } = Astro.props;
const contentResult = await getHomeContentResult();
const { profile, timeline, featuredWorks, works } = contentResult.data;
applyPublicContentStatus(Astro.response.headers, contentResult.source);
const categories = ["ALL", "UI/UX", "BI/BX"];
const logoPath = "M22.0732 0.000976562H27.4131V49.124L44.1484 39.4609V16.8125H49.4883V42.5039L49.4873 42.5479L27.4141 55.291L27.4131 55.2891H22.0732V6.16602L5.33984 15.8271V38.4883H0V12.7432L22.0723 0L22.0732 0.000976562Z";
const fallbackPortraitSrc = "/assets/figma/profile-guitar.png";
const portraitSource = profile.portrait?.url
  ? buildResponsiveImageSource(profile.portrait)
  : { src: fallbackPortraitSrc };
const portraitSrc = portraitSource.src;
const portraitWidth = profile.portrait?.width ?? 768;
const portraitHeight = profile.portrait?.height ?? 1024;
const deferPortrait = initialSection === "intro";
const slogan = profile.headline.replace(/\.$/, "");
const emailLink = profile.links.find((link) => link.url.startsWith("mailto:"));
const phoneLink = profile.links.find((link) => link.url.startsWith("tel:") || /010[-\d]+/.test(link.label));
const locationLink = profile.links.find((link) => link.label.includes("서울") || link.label.toLowerCase() === "location");
const identityTravelSvh = Math.max(210, 126 + timeline.length * 18) + 200 + 100;
const mobileIdentityTravelSvh = Math.max(330, 190 + timeline.length * 34) + 200 + 100;
const yearDateTime = (year: string | null | undefined) => year?.match(/\d{4}/)?.[0] ?? "2026";
const filterId = (category: string) => `work-filter-${category.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "all"}`;
const structuredData = createHomeStructuredData(profile);
const safeProfileIntro = sanitizeProfileIntro(profile.intro);
---

<PublicLayout
  title={`${profile.headline} | ${profile.name}`}
  description={profile.bio}
  htmlClass="home-scroll"
  bodyClass="home-body"
  canonicalPath="/"
  structuredData={structuredData}
  skipTarget="#about"
>
  {initialSection === "intro" ? (
    <>
      <script is:inline>document.documentElement.classList.add("home-is-loading");</script>
      <div class="home-loader" data-home-loader role="status" aria-live="polite">
        <div class="home-loader-spinner" aria-hidden="true" />
        <span class="visually-hidden">포트폴리오 불러오는 중</span>
      </div>
    </>
  ) : null}
  <main id="main-content" class="site-shell" data-initial-section={initialSection} tabindex="-1" aria-busy={initialSection === "intro" ? "true" : undefined}>
    <section class="intro-section" aria-label="Intro" data-route="/">
      <div class="intro-grid">
        <svg class="site-logo intro-logo" viewBox="0 0 50 56" aria-hidden="true" focusable="false">
          <path d={logoPath} fill="currentColor" />
        </svg>
        <h1 class="intro-title">
          <span data-intro-typewriter={slogan}>{slogan}</span><span class="intro-dot" aria-hidden="true">.</span>
        </h1>
        <div class="intro-scroll-cue" aria-hidden="true">
          <p></p>
        </div>
      </div>
    </section>

    <section
      class="identity-section"
      id="about"
      tabindex="-1"
      data-identity
      data-route="/about"
      style={`--identity-travel:${identityTravelSvh}svh; --identity-mobile-travel:${mobileIdentityTravelSvh}svh;`}
    >
      <div class="identity-stage">
        <div class="identity-copy">
          <svg class="profile-logo" viewBox="0 0 50 56" aria-hidden="true" focusable="false">
            <path d={logoPath} fill="currentColor" />
          </svg>
          <div class="identity-copy-stack">
            <div class="profile-intro identity-copy-panel is-active" data-type-copy="about" set:html={safeProfileIntro} />
            <div class="timeline-heading identity-copy-panel" data-type-copy="career">
              <h2>초등학교 방과 후 교실에서 포토샵에 흥미를 가진 이후,<br />2014년부터 계속 활동하고 있습니다.</h2>
            </div>
          </div>
          <div class="profile-contact" data-profile-contact>
            <strong>{profile.name}</strong>
            {emailLink ? (
              <a href={emailLink.url}>
                <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                  <path d="M4 6h16v12H4z" />
                  <path d="m4 7 8 6 8-6" />
                </svg>
                {emailLink.label}
              </a>
            ) : null}
            {phoneLink ? (
              <a href={phoneLink.url}>
                <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                  <path d="M6.5 4.5 9 4l2 5-1.5 1.2a11 11 0 0 0 4.3 4.3L15 13l5 2-.5 2.5c-.2 1-1.2 1.7-2.3 1.5C10.7 18 6 13.3 5 6.8c-.2-1.1.5-2.1 1.5-2.3Z" />
                </svg>
                {phoneLink.label}
              </a>
            ) : null}
            {locationLink ? (
              <span>
                <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                  <path d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11Z" />
                  <path d="M12 10.5h.01" />
                </svg>
                {locationLink.label}
              </span>
            ) : null}
          </div>
        </div>

        <div class="identity-side">
          <figure class="profile-media" data-profile-media>
            <div class="profile-media-visual" data-image-frame>
              <img
                src={deferPortrait ? undefined : portraitSrc}
                data-deferred-src={deferPortrait ? portraitSrc : undefined}
                srcset={deferPortrait ? undefined : portraitSource.srcset}
                data-deferred-srcset={deferPortrait ? portraitSource.srcset : undefined}
                sizes="(max-width: 760px) 100vw, 50vw"
                alt={profile.portrait?.alt ?? profile.name}
                width={portraitWidth}
                height={portraitHeight}
                loading={deferPortrait ? "lazy" : "eager"}
                decoding="async"
                fetchpriority={deferPortrait ? "low" : "high"}
                data-public-image
              />
              {deferPortrait ? <noscript><img src={portraitSrc} srcset={portraitSource.srcset} sizes="(max-width: 760px) 100vw, 50vw" alt={profile.portrait?.alt ?? profile.name} width={portraitWidth} height={portraitHeight} /></noscript> : null}
            </div>
            <figcaption>취미로 기타를 치고 있습니다.</figcaption>
          </figure>

          <div class="timeline-items" data-career-list>
            <div class="timeline-track" data-timeline-track>
              {
                timeline.map((item, index) => (
                  <button
                    type="button"
                    class:list={["timeline-card", index === 0 && "is-active"]}
                    data-timeline-card
                    data-timeline-index={index}
                    aria-label={`${item.period} ${item.title} 이력으로 이동`}
                  >
                    <p>{item.period}</p>
                    <div class="timeline-card-details">
                      <div class="timeline-card-details-inner">
                        <h3>{item.title}</h3>
                        <span>{item.organization}</span>
                      </div>
                    </div>
                  </button>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="work-intro-section" id="work" aria-label="Work intro" data-route="/work">
      <svg class="site-logo" viewBox="0 0 50 56" aria-hidden="true" focusable="false">
        <path d={logoPath} fill="currentColor" />
      </svg>
      <h2>WORK</h2>
    </section>

    <section class:list={["featured-section", featuredWorks.length === 0 && "is-empty"]} id="featured-work" data-route="/work">
      <div class="featured-stage">
        <div class="section-heading">
          <p class="section-kicker">Selected Work</p>
        </div>
        <div class="featured-list">
          {
            featuredWorks.map((work, index) => {
              const image = work.featuredThumbnail?.url ? work.featuredThumbnail : work.thumbnail;
              const imageSource = buildResponsiveImageSource(image);
              return (
              <article
                class:list={["featured-work", index === 0 && "is-active"]}
                style={`--work-index:${index};`}
                data-featured-panel
                data-route="/work"
                aria-hidden={index === 0 ? "false" : "true"}
              >
                <a
                  class="featured-link"
                  href={`/work/${work.slug}`}
                  aria-label={`${work.title} 자세히 보기`}
                  tabindex={index === 0 ? undefined : -1}
                >
                  <div class="work-visual" data-image-frame>
                    {image?.url ? (
                      <img
                        src={imageSource.src}
                        srcset={imageSource.srcset}
                        sizes="100vw"
                        alt={image.alt ?? work.title}
                        crossorigin="anonymous"
                        width={image.width ?? undefined}
                        height={image.height ?? undefined}
                        loading="lazy"
                        decoding="async"
                        data-public-image
                      />
                    ) : null}
                  </div>
                  <div class="featured-copy">
                    <span class="featured-category">{work.category}</span>
                    <h3>{work.title}</h3>
                    <p class="featured-meta">
                      <time datetime={yearDateTime(work.year)}>{work.year}</time>
                      {work.client ? <span>{work.client}</span> : null}
                      <span>{work.role || "Figma + Adobe Illustrator"}</span>
                    </p>
                    <span class="featured-more" aria-hidden="true"><span>더 알아보기</span></span>
                  </div>
                </a>
              </article>
              );
            })
          }
        </div>
        {
          featuredWorks.length > 1 ? (
            <div class="featured-dots" aria-label="Featured work navigation">
              {
                featuredWorks.map((work, index) => (
                  <button
                    type="button"
                    class:list={[index === 0 && "is-active"]}
                    data-featured-dot
                    data-featured-target={index}
                    aria-label={`${work.title} 보기`}
                  >
                    <span class="featured-dot-mark" aria-hidden="true" />
                    <span class="featured-dot-label">{work.title}</span>
                  </button>
                ))
              }
            </div>
          ) : null
        }
      </div>
    </section>

    <section class:list={["gallery-section", featuredWorks.length === 0 && "is-featured-empty"]} aria-label="Work gallery" data-route="/work">
      <div class="gallery-canvas">
        <div class="section-heading gallery-heading">
          <div class="category-filter" role="tablist" aria-label="Work category" aria-orientation="horizontal">
            {
              categories.map((category) => (
                <button
                  type="button"
                  role="tab"
                  id={filterId(category)}
                  class:list={[category === "ALL" && "is-active"]}
                  data-filter={category}
                  aria-selected={category === "ALL" ? "true" : "false"}
                  aria-controls="work-gallery-grid"
                  tabindex={category === "ALL" ? 0 : -1}
                >
                  {category}
                </button>
              ))
            }
          </div>
        </div>
        <div class="work-grid" id="work-gallery-grid" role="tabpanel" aria-labelledby={filterId("ALL")}>
          {
            works.map((work) => {
              const imageSource = buildResponsiveImageSource(work.thumbnail);
              return (
              <a class="work-tile" href={`/work/${work.slug}`} data-category={work.category} aria-label={`${work.title} 자세히 보기`}>
                <div class:list={["work-tile-media", work.thumbnail?.url && "has-image"]} data-image-frame>
                  {work.thumbnail?.url ? (
                    <img
                      src={imageSource.src}
                      srcset={imageSource.srcset}
                      sizes="(max-width: 760px) 100vw, (max-width: 1280px) 50vw, 33vw"
                      alt=""
                      width={work.thumbnail.width ?? undefined}
                      height={work.thumbnail.height ?? undefined}
                      loading="lazy"
                      decoding="async"
                      data-public-image
                    />
                  ) : null}
                </div>
                <div>
                  <h3>{work.title}</h3>
                </div>
              </a>
              );
            })
          }
        </div>
        {works.length > 0 ? (
          <div class="gallery-filter-empty" data-gallery-filter-empty hidden>
            <p>이런... 아직 작업물이 없네요.</p>
            <span>새로운 프로젝트를 준비하고 있습니다.</span>
          </div>
        ) : null}
        {works.length === 0 ? (
          <div class="gallery-empty" role="status">
            <p>공개된 작업물이 없습니다.</p>
            <span>새 작업물이 준비되는 대로 이곳에 표시됩니다.</span>
          </div>
        ) : null}
        <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-gallery-status>전체 작업물 {works.length}개</p>
      </div>
    </section>
  </main>

  <script>
    import "../scripts/home-page";
  </script>
</PublicLayout>

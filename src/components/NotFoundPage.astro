---
interface Props {
  title?: string;
  message?: string;
}

const {
  title = "페이지를 찾을 수 없습니다.",
  message = "주소가 변경되었거나 더 이상 제공되지 않는 페이지입니다."
} = Astro.props;
---

<main id="main-content" class="not-found" tabindex="-1">
  <div class="not-found-inner">
    <p class="section-kicker">404</p>
    <h1>{title}</h1>
    <p class="not-found-copy">{message}</p>
    <nav class="not-found-actions" aria-label="이동할 페이지">
      <a href="/">처음으로</a>
      <a href="/work">작업물 보기</a>
    </nav>
  </div>
</main>

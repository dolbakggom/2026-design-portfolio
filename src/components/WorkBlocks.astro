---
import type { WorkBlock } from "../types";

interface Props {
  blocks: WorkBlock[];
}

const { blocks } = Astro.props;

const textOf = (block: WorkBlock, key = "text") => {
  const value = block.content[key];
  return typeof value === "string" ? value : "";
};

const htmlOf = (block: WorkBlock) => {
  const value = block.content.html;
  return typeof value === "string" ? value : "";
};

const imagesOf = (block: WorkBlock) => {
  const value = block.content.images;
  return Array.isArray(value) ? value : [];
};

const optionOf = (block: WorkBlock, key: string, allowed: string[], fallback: string) => {
  const value = block.content[key];
  return typeof value === "string" && allowed.includes(value) ? value : fallback;
};

const textBlockStyle = (block: WorkBlock, defaults = { lineHeight: "1.7", paragraphGap: "18px" }) => {
  const lineHeight = optionOf(block, "lineHeight", ["1.3", "1.5", "1.7", "1.9"], defaults.lineHeight);
  const paragraphGap = optionOf(block, "paragraphGap", ["0px", "10px", "18px", "28px"], defaults.paragraphGap);
  const blockWidth = optionOf(block, "blockWidth", ["680px", "880px", "1080px", "100%"], "880px");
  const align = optionOf(block, "align", ["left", "center"], "left");
  return `--block-line-height:${lineHeight};--block-paragraph-gap:${paragraphGap};--block-max-width:${blockWidth};--block-align:${align};`;
};
---

<div class="work-blocks">
  {
    blocks.map((block) => {
      if (block.type === "heading") {
        return <h2 class="work-block-heading" style={textBlockStyle(block, { lineHeight: "1.3", paragraphGap: "0px" })}>{textOf(block)}</h2>;
      }

      if (block.type === "paragraph") {
        return <div class="work-block-copy" style={textBlockStyle(block)} set:html={htmlOf(block)} />;
      }

      if (block.type === "quote") {
        return <div class="work-block-quote" style={textBlockStyle(block, { lineHeight: "1.5", paragraphGap: "10px" })} set:html={htmlOf(block)} />;
      }

      if (block.type === "image") {
        const src = textOf(block, "url");
        const alt = textOf(block, "alt");
        const caption = textOf(block, "caption");
        return (
          <figure class="work-block-image">
            {src ? <img src={src} alt={alt} loading="lazy" decoding="async" /> : <div class="media-placeholder" aria-label="No image" />}
            {caption ? <figcaption>{caption}</figcaption> : null}
          </figure>
        );
      }

      if (block.type === "gallery") {
        return (
          <div class="work-block-gallery">
            {imagesOf(block).map((image) => {
              if (!image || typeof image !== "object") return null;
              const src = "url" in image && typeof image.url === "string" ? image.url : "";
              const alt = "alt" in image && typeof image.alt === "string" ? image.alt : "";
              return src ? <img src={src} alt={alt} loading="lazy" decoding="async" /> : null;
            })}
          </div>
        );
      }

      return null;
    })
  }
</div>

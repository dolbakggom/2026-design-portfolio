---
import type { AssetRef, AssetVariant, WorkBlock } from "../types";
import { sanitizeRichTextHtml } from "../lib/content-sanitizer";
import { buildResponsiveImageSource } from "../lib/responsive-images";

interface Props {
  blocks: WorkBlock[];
}

const { blocks } = Astro.props;

const textOf = (block: WorkBlock, key = "text") => {
  const value = block.content[key];
  return typeof value === "string" ? value : "";
};

const htmlOf = (block: WorkBlock) => {
  const value = block.content.html;
  return typeof value === "string" ? sanitizeRichTextHtml(value) : "";
};

const imagesOf = (block: WorkBlock) => {
  const value = block.content.images;
  return Array.isArray(value) ? value : [];
};

const numberOf = (value: unknown) => typeof value === "number" && value > 0 ? value : undefined;

const sourceOf = (value: unknown) => {
  const image = value && typeof value === "object" ? value as Record<string, unknown> : {};
  return buildResponsiveImageSource({
      url: typeof image.url === "string" ? image.url : "",
      mime: typeof image.mime === "string" ? image.mime : null,
      width: numberOf(image.width),
      height: numberOf(image.height),
      variants: Array.isArray(image.variants) ? image.variants as AssetVariant[] : undefined
    } satisfies AssetRef);
};

const optionOf = (block: WorkBlock, key: string, allowed: string[], fallback: string) => {
  const value = block.content[key];
  return typeof value === "string" && allowed.includes(value) ? value : fallback;
};

const codeLanguages: Record<string, string> = {
  plaintext: "Plain text",
  html: "HTML",
  css: "CSS",
  javascript: "JavaScript",
  typescript: "TypeScript",
  json: "JSON",
  bash: "Shell"
};

const textBlockStyle = (block: WorkBlock, defaults = { lineHeight: "1.7", paragraphGap: "18px" }) => {
  const lineHeight = optionOf(block, "lineHeight", ["1.3", "1.5", "1.7", "1.9"], defaults.lineHeight);
  const paragraphGap = optionOf(block, "paragraphGap", ["0px", "10px", "18px", "28px"], defaults.paragraphGap);
  const blockWidth = optionOf(block, "blockWidth", ["680px", "880px", "1080px", "100%"], "100%");
  const align = optionOf(block, "align", ["left", "center"], "left");
  return `--block-line-height:${lineHeight};--block-paragraph-gap:${paragraphGap};--block-max-width:${blockWidth};--block-align:${align};`;
};
---

<div class="work-blocks">
  {
    blocks.map((block) => {
      if (block.type === "heading") {
        return <h2 class="work-block-heading" style={textBlockStyle(block, { lineHeight: "1.3", paragraphGap: "0px" })}>{textOf(block)}</h2>;
      }

      if (block.type === "paragraph") {
        return <div class="work-block-copy" style={textBlockStyle(block)} set:html={htmlOf(block)} />;
      }

      if (block.type === "quote") {
        return <div class="work-block-quote" style={textBlockStyle(block, { lineHeight: "1.5", paragraphGap: "10px" })} set:html={htmlOf(block)} />;
      }

      if (block.type === "code") {
        const code = textOf(block, "code");
        const language = optionOf(block, "language", Object.keys(codeLanguages), "plaintext");
        const blockWidth = optionOf(block, "blockWidth", ["680px", "880px", "1080px", "100%"], "100%");
        return (
          <figure class="work-block-code" style={`--block-max-width:${blockWidth};`} data-code-block>
            <figcaption>
              <span class="work-code-window-dots" aria-hidden="true"><i /><i /><i /></span>
              <span class="work-code-language">{codeLanguages[language]}</span>
              <button type="button" data-code-copy aria-label="코드 복사"><span data-code-copy-label>Copy</span></button>
            </figcaption>
            <pre><code>{code}</code></pre>
          </figure>
        );
      }

      if (block.type === "image") {
        const src = textOf(block, "url");
        const alt = textOf(block, "alt");
        const caption = textOf(block, "caption");
        const imageSource = sourceOf(block.content);
        return (
          <figure class:list={["work-block-image", !src && "is-image-unavailable"]} data-image-frame>
            {src ? (
              <img
                src={imageSource.src}
                srcset={imageSource.srcset}
                sizes="(max-width: 1080px) 100vw, 1080px"
                alt={alt}
                width={numberOf(block.content.width)}
                height={numberOf(block.content.height)}
                loading="lazy"
                decoding="async"
                data-public-image
              />
            ) : null}
            <div class="media-placeholder" aria-hidden="true" />
            {caption ? <figcaption>{caption}</figcaption> : null}
          </figure>
        );
      }

      if (block.type === "gallery") {
        return (
          <div class="work-block-gallery">
            {imagesOf(block).map((image) => {
              if (!image || typeof image !== "object") return null;
              const src = "url" in image && typeof image.url === "string" ? image.url : "";
              const alt = "alt" in image && typeof image.alt === "string" ? image.alt : "";
              const width = "width" in image ? numberOf(image.width) : undefined;
              const height = "height" in image ? numberOf(image.height) : undefined;
              const imageSource = sourceOf(image);
              return (
                <div class:list={["work-block-gallery-item", !src && "is-image-unavailable"]} data-image-frame>
                  {src ? <img src={imageSource.src} srcset={imageSource.srcset} sizes="(max-width: 760px) 100vw, 50vw" alt={alt} width={width} height={height} loading="lazy" decoding="async" data-public-image /> : null}
                  <div class="media-placeholder" aria-hidden="true" />
                </div>
              );
            })}
          </div>
        );
      }

      if (block.type === "divider") {
        return <hr class="work-block-divider" />;
      }

      if (block.type === "website") {
        const href = textOf(block, "url");
        if (!href) return null;
        const domain = textOf(block, "domain") || new URL(href).hostname.replace(/^www\./, "");
        const title = textOf(block, "title") || domain;
        const description = textOf(block, "description");
        const imageUrl = textOf(block, "imageUrl");
        return (
          <a class="work-block-website" href={href} target="_blank" rel="noopener noreferrer" aria-label={`${title} 웹사이트 열기`}>
            <span class:list={["work-block-website-media", !imageUrl && "is-image-unavailable"]} aria-hidden="true">
              {imageUrl ? (
                <img
                  src={imageUrl}
                  alt=""
                  width={numberOf(block.content.imageWidth)}
                  height={numberOf(block.content.imageHeight)}
                  loading="lazy"
                  decoding="async"
                  data-public-image
                />
              ) : null}
              <span class="work-block-website-placeholder" />
            </span>
            <span class="work-block-website-copy">
              <span class="work-block-website-domain">{domain}</span>
              <strong>{title}</strong>
              {description ? <span class="work-block-website-description">{description}</span> : null}
              <span class="work-block-website-action">
                사이트 바로가기
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <path d="M5 12h14" />
                  <path d="m13 6 6 6-6 6" />
                </svg>
              </span>
            </span>
          </a>
        );
      }

      return null;
    })
  }
</div>

<script>
  document.addEventListener("click", async (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>("[data-code-copy]");
    if (!button) return;

    const code = button.closest<HTMLElement>("[data-code-block]")?.querySelector("code")?.textContent ?? "";
    try {
      await navigator.clipboard.writeText(code);
      const label = button.querySelector<HTMLElement>("[data-code-copy-label]");
      if (label) label.textContent = "Copied";
      button.classList.add("is-copied");
      window.setTimeout(() => {
        if (label) label.textContent = "Copy";
        button.classList.remove("is-copied");
      }, 1600);
    } catch {
      button.classList.add("is-copy-error");
      window.setTimeout(() => button.classList.remove("is-copy-error"), 1600);
    }
  });
</script>

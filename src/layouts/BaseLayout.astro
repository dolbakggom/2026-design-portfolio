---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  htmlClass?: string;
  bodyClass?: string;
}

const {
  title = "Beyond the Answer.",
  description = "UI/UX and BI/BX design portfolio.",
  htmlClass = "",
  bodyClass = ""
} = Astro.props;
---

<!doctype html>
<html lang="ko" class={htmlClass}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f4ee" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>

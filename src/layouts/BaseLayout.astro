---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  htmlClass?: string;
  bodyClass?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title = "Beyond the Answer.",
  description = "UI/UX and BI/BX design portfolio.",
  htmlClass = "",
  bodyClass = "",
  image = "/og-image.svg",
  imageAlt = "Beyond the Answer. portfolio preview",
  type = "website",
  noindex = false
} = Astro.props;
const isAdminBody = bodyClass.includes("admin-body");
const needsReactRefreshPreamble = import.meta.env.DEV && isAdminBody;
const siteOrigin = Astro.site?.origin ?? "https://dolbakggom.com";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const absoluteImageUrl = new URL(image, siteOrigin).toString();
const metaDescription = description.trim() || "UI/UX and BI/BX design portfolio.";
---

<!doctype html>
<html lang="ko" class={htmlClass}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#f7f4ee" />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <meta property="og:site_name" content="Beyond the Answer." />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImageUrl} />
    <meta property="og:image:secure_url" content={absoluteImageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={absoluteImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="author" content="Ham Sihyeon" />
    <title>{title}</title>
    <slot name="head" />
    {
      needsReactRefreshPreamble ? (
        <script type="module" is:inline>
          import RefreshRuntime from "/@react-refresh";
          RefreshRuntime.injectIntoGlobalHook(window);
          window.$RefreshReg$ = () => {};
          window.$RefreshSig$ = () => (type) => type;
          window.__vite_plugin_react_preamble_installed__ = true;
        </script>
      ) : null
    }
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>

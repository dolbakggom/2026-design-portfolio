---
import BaseLayout from "./BaseLayout.astro";
import type { JsonLd } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  htmlClass?: string;
  bodyClass?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: "website" | "article";
  noindex?: boolean;
  canonicalPath?: string;
  structuredData?: JsonLd;
  skipTarget?: string;
}

const props = Astro.props as Props;
const { skipTarget = "#main-content" } = props;
---

<BaseLayout {...props}>
  <script is:inline slot="head">
    document.documentElement.classList.add("portfolio-fade-ready");
  </script>
  <script>
    type LenisInstance = import("lenis").default;

    type PortfolioWindow = Window & {
      __portfolioLenis?: LenisInstance;
      __portfolioLenisCleanup?: () => void;
      __portfolioLenisScrollTo?: (target: number | string | HTMLElement, options?: Parameters<LenisInstance["scrollTo"]>[1]) => void;
    };

    let portfolioMotionPromise: Promise<void> | null = null;

    const initPortfolioLenis = () => {
      if (portfolioMotionPromise) return portfolioMotionPromise;
      portfolioMotionPromise = (async () => {
      const portfolioWindow = window as PortfolioWindow;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      portfolioWindow.__portfolioLenisCleanup?.();

      if (reduceMotion || !document.documentElement.classList.contains("home-scroll")) {
        delete portfolioWindow.__portfolioLenis;
        delete portfolioWindow.__portfolioLenisScrollTo;
        portfolioWindow.__portfolioLenisCleanup = () => {};
        return;
      }

      const [{ default: Lenis }, { default: gsap }, { ScrollTrigger }] = await Promise.all([
        import("lenis"),
        import("gsap"),
        import("gsap/ScrollTrigger")
      ]);
      gsap.registerPlugin(ScrollTrigger);

      const lenis = new Lenis({
        anchors: true,
        lerp: 0.08,
        smoothWheel: true,
        syncTouch: true,
        touchMultiplier: 1.1,
        wheelMultiplier: 1
      });
      const updateScrollTrigger = () => ScrollTrigger.update();
      const raf = (time: number) => lenis.raf(time * 1000);

      lenis.on("scroll", updateScrollTrigger);
      gsap.ticker.add(raf);
      gsap.ticker.lagSmoothing(0);

      portfolioWindow.__portfolioLenis = lenis;
      portfolioWindow.__portfolioLenisScrollTo = (target, options) => {
        lenis.scrollTo(target, options);
      };
      portfolioWindow.__portfolioLenisCleanup = () => {
        lenis.off("scroll", updateScrollTrigger);
        gsap.ticker.remove(raf);
        lenis.destroy();
        delete portfolioWindow.__portfolioLenis;
        delete portfolioWindow.__portfolioLenisScrollTo;
        portfolioWindow.__portfolioLenisCleanup = () => {};
      };

      ScrollTrigger.refresh();
      })().catch(() => {
        portfolioMotionPromise = null;
      });
      return portfolioMotionPromise;
    };

    document.addEventListener("astro:before-swap", () => {
      (window as PortfolioWindow).__portfolioLenisCleanup?.();
      portfolioMotionPromise = null;
    });
    document.addEventListener("portfolio:motion-intent", initPortfolioLenis);
    document.addEventListener("astro:page-load", () => {
      if (document.documentElement.classList.contains("home-scroll") && window.location.pathname !== "/") {
        void initPortfolioLenis();
      }
    });
  </script>
  <a class="skip-link" href={skipTarget}>본문으로 건너뛰기</a>
  <slot />
  <script>
    import { hasImageLoadFailed } from "../lib/public-resilience";

    type PublicImageWindow = Window & {
      __publicImageFallbackCleanup?: () => void;
    };

    const initPublicImageFallbacks = () => {
      const publicWindow = window as PublicImageWindow;
      publicWindow.__publicImageFallbackCleanup?.();

      const controller = new AbortController();
      const images = document.querySelectorAll<HTMLImageElement>("img[data-public-image]");

      images.forEach((image) => {
        const frame = image.closest<HTMLElement>("[data-image-frame]");
        if (!frame) return;

        const showFallback = () => {
          frame.classList.add("is-image-unavailable");
          image.hidden = true;
          image.setAttribute("aria-hidden", "true");

          const alt = image.alt.trim();
          if (alt) {
            frame.setAttribute("role", "img");
            frame.setAttribute("aria-label", `${alt} 이미지를 불러오지 못했습니다.`);
          }
        };

        const restoreImage = () => {
          frame.classList.remove("is-image-unavailable");
          frame.removeAttribute("role");
          frame.removeAttribute("aria-label");
          image.hidden = false;
          image.removeAttribute("aria-hidden");
        };

        const isWaitingForDeferredSource = image.hasAttribute("data-deferred-src");
        if (hasImageLoadFailed(image.complete, image.naturalWidth, isWaitingForDeferredSource)) {
          showFallback();
          return;
        }

        image.addEventListener("load", restoreImage, { signal: controller.signal });
        image.addEventListener("error", showFallback, { once: true, signal: controller.signal });
      });

      publicWindow.__publicImageFallbackCleanup = () => controller.abort();
    };

    document.addEventListener("astro:before-swap", () => {
      (window as PublicImageWindow).__publicImageFallbackCleanup?.();
    });
    document.addEventListener("astro:page-load", initPublicImageFallbacks);
    initPublicImageFallbacks();
  </script>
  <button class="floating-top-button" type="button" data-floating-top aria-label="맨 위로 이동">↑</button>
  <script is:inline>
    if (!window.__portfolioFadeNavigationSetup) {
      window.__portfolioFadeNavigationSetup = true;
      const root = document.documentElement;
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const fadeDuration = 180;

      const navigateAfterFade = (callback) => {
        if (reducedMotion.matches) {
          callback();
          return;
        }

        root.classList.add("portfolio-fade-leaving");
        window.setTimeout(callback, fadeDuration);
      };

      const canUseHistoryBack = () => {
        if (window.history.length <= 1 || !document.referrer) return false;

        try {
          return new URL(document.referrer).origin === window.location.origin;
        } catch {
          return false;
        }
      };

      document.addEventListener("click", (event) => {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }

        const target = event.target instanceof Element ? event.target : null;
        const backControl = target?.closest("[data-history-back]");

        if (backControl) {
          event.preventDefault();
          navigateAfterFade(() => {
            if (canUseHistoryBack()) {
              window.history.back();
              return;
            }

            window.location.href = "/work";
          });
          return;
        }

        const link = target?.closest("a[href]");
        if (!link || link.target || link.hasAttribute("download")) return;

        const url = new URL(link.href, window.location.href);
        const isSamePageHash =
          url.pathname === window.location.pathname &&
          url.search === window.location.search &&
          url.hash;

        if (url.origin !== window.location.origin || isSamePageHash || url.href === window.location.href) return;

        event.preventDefault();
        navigateAfterFade(() => {
          window.location.href = url.href;
        });
      });

      window.addEventListener("pageshow", () => {
        root.classList.remove("portfolio-fade-leaving");
      });
    }
  </script>
  <script is:inline data-astro-rerun>
    (() => {
      window.__floatingTopController?.abort?.();
      const controller = new AbortController();
      window.__floatingTopController = controller;
      const button = document.querySelector("[data-floating-top]");
      let isSyncQueued = false;
      let isVisible = false;

      if (!button) return;

      const syncButton = () => {
        isSyncQueued = false;
        const root = document.documentElement;
        const canScroll = root.scrollHeight > window.innerHeight * 1.25;
        const nearBottom = window.scrollY + window.innerHeight >= root.scrollHeight - Math.max(220, window.innerHeight * 0.18);
        const nextVisible = canScroll && nearBottom;

        if (nextVisible === isVisible) return;

        isVisible = nextVisible;
        button.classList.toggle("is-visible", nextVisible);
      };

      const queueButtonSync = () => {
        if (isSyncQueued) return;
        isSyncQueued = true;
        window.requestAnimationFrame(syncButton);
      };

      button.addEventListener("click", () => {
        if (typeof window.__portfolioScrollToTop === "function") {
          window.__portfolioScrollToTop();
          return;
        }

        if (typeof window.__portfolioLenisScrollTo === "function") {
          window.__portfolioLenisScrollTo(0, { duration: 1.05 });
          return;
        }

        window.scrollTo({ top: 0, behavior: "smooth" });
      }, { signal: controller.signal });
      window.addEventListener("scroll", queueButtonSync, { passive: true, signal: controller.signal });
      window.addEventListener("resize", queueButtonSync, { signal: controller.signal });
      window.addEventListener("load", queueButtonSync, { once: true, signal: controller.signal });
      document.addEventListener("astro:before-swap", () => controller.abort(), { once: true, signal: controller.signal });
      window.requestAnimationFrame(() => window.requestAnimationFrame(queueButtonSync));
    })();
  </script>
</BaseLayout>

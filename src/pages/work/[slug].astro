---
import PublicLayout from "../../layouts/PublicLayout.astro";
import WorkBlocks from "../../components/WorkBlocks.astro";
import { getWorkBySlug } from "../../lib/content";

export const prerender = false;

const { slug } = Astro.params;
const work = slug ? await getWorkBySlug(slug) : null;
const coverImage = work?.featuredThumbnail?.url ? work.featuredThumbnail : work?.thumbnail?.url ? work.thumbnail : null;
const yearDateTime = work?.year?.match(/\d{4}/)?.[0] ?? "2026";

if (!work) {
  Astro.response.status = 404;
}
---

<PublicLayout title={work ? `${work.title} | Beyond the Answer.` : "Work not found"}>
  {
    work ? (
      <main class="work-detail">
        <section class="work-detail-cover" data-detail-cover data-cover-tone="light">
          <div class="work-detail-topbar">
            <button class="back-link work-back-link" type="button" aria-label="Back to work" data-history-back>←</button>
            <span class="work-topbar-title" data-detail-topbar-title>{work.title}</span>
          </div>
          <div class="work-detail-cover-fixed">
            {coverImage?.url ? (
              <img src={coverImage.url} alt={coverImage.alt ?? work.title} crossorigin="anonymous" data-cover-image />
            ) : (
              <div class="work-detail-cover-placeholder" aria-hidden="true" />
            )}
            <span class="work-detail-cover-fade" aria-hidden="true" />
          </div>
        </section>
        <header class="work-hero">
          <div class="work-hero-copy">
            <p class="section-kicker">{work.category}</p>
            <h1>{work.title}</h1>
            <p>{work.summary}</p>
          </div>
          <dl class="work-meta">
            <div>
              <dt>Client</dt>
              <dd>{work.client || "Selected Project"}</dd>
            </div>
            <div>
              <dt>Year</dt>
              <dd><time datetime={yearDateTime}>{work.year || "2026"}</time></dd>
            </div>
            <div>
              <dt>Role</dt>
              <dd>{work.role || "Design"}</dd>
            </div>
          </dl>
        </header>
        <WorkBlocks blocks={work.blocks ?? []} />
      </main>
    ) : (
      <main class="not-found">
        <p class="section-kicker">404</p>
        <h1>작업물을 찾을 수 없습니다.</h1>
        <a href="/">메인으로 돌아가기</a>
      </main>
    )
  }
  <script>
    let activeDetailCover: HTMLElement | null = null;
    let cleanupWorkDetail = () => {};

    const initWorkDetail = () => {
      const detailCover = document.querySelector<HTMLElement>("[data-detail-cover]");
      if (detailCover && detailCover === activeDetailCover) return;

      cleanupWorkDetail();

      if (!detailCover) {
        activeDetailCover = null;
        return;
      }

      activeDetailCover = detailCover;
      const controller = new AbortController();
      const coverImage = document.querySelector<HTMLImageElement>("[data-cover-image]");
      const coverFixed = document.querySelector<HTMLElement>(".work-detail-cover-fixed");
      const backButton = document.querySelector<HTMLElement>("[data-history-back]");
      const detailTitle = document.querySelector<HTMLElement>(".work-hero h1");
      let coverFrame = 0;

      cleanupWorkDetail = () => {
        controller.abort();
        window.cancelAnimationFrame(coverFrame);
        activeDetailCover = null;
        cleanupWorkDetail = () => {};
      };

      const updateCoverTone = () => {
        if (!coverImage || !coverImage.naturalWidth || !coverFixed || !backButton) {
          detailCover.setAttribute("data-cover-tone", "light");
          return;
        }

        try {
          const canvas = document.createElement("canvas");
          const size = 72;
          canvas.width = size;
          canvas.height = size;
          const context = canvas.getContext("2d", { willReadFrequently: true });
          if (!context) return;

          const coverRect = coverFixed.getBoundingClientRect();
          const buttonRect = backButton.getBoundingClientRect();
          const sampleSize = Math.max(buttonRect.width, buttonRect.height, size);
          const sampleLeft = buttonRect.left + buttonRect.width / 2 - sampleSize / 2;
          const sampleTop = buttonRect.top + buttonRect.height / 2 - sampleSize / 2;
          const imageScale = Math.max(coverRect.width / coverImage.naturalWidth, coverRect.height / coverImage.naturalHeight) * 1.02;
          const drawnWidth = coverImage.naturalWidth * imageScale;
          const drawnHeight = coverImage.naturalHeight * imageScale;
          const drawnLeft = coverRect.left + (coverRect.width - drawnWidth) / 2;
          const drawnTop = coverRect.top + (coverRect.height - drawnHeight) / 2;

          context.drawImage(
            coverImage,
            drawnLeft - sampleLeft,
            drawnTop - sampleTop,
            drawnWidth,
            drawnHeight
          );

          const pixels = context.getImageData(0, 0, size, size).data;
          const paperChannel = 244;
          const imageOpacity = 0.9;
          let total = 0;
          let count = 0;

          for (let index = 0; index < pixels.length; index += 4) {
            const alpha = (pixels[index + 3] / 255) * imageOpacity;
            const red = pixels[index] * alpha + paperChannel * (1 - alpha);
            const green = pixels[index + 1] * alpha + paperChannel * (1 - alpha);
            const blue = pixels[index + 2] * alpha + paperChannel * (1 - alpha);
            total += 0.2126 * red + 0.7152 * green + 0.0722 * blue;
            count += 1;
          }

          const luminance = count ? total / count : 255;
          detailCover.setAttribute("data-cover-tone", luminance > 154 ? "light" : "dark");
        } catch {
          detailCover.setAttribute("data-cover-tone", "light");
        }
      };

      const updateCoverFade = () => {
        const coverTop = detailCover.offsetTop;
        const coverHeight = Math.max(1, detailCover.offsetHeight);
        const progress = Math.min(1, Math.max(0, (window.scrollY - coverTop) / (coverHeight * 0.76)));
        detailCover.style.setProperty("--cover-fade", progress.toFixed(3));
        detailCover.dataset.coverScrolled = progress > 0.48 ? "true" : "false";

        if (detailTitle) {
          const titleRect = detailTitle.getBoundingClientRect();
          const titleHidden = titleRect.bottom <= 92;
          detailCover.dataset.titleHidden = titleHidden ? "true" : "false";
        }
      };

      const requestCoverFade = () => {
        window.cancelAnimationFrame(coverFrame);
        coverFrame = window.requestAnimationFrame(updateCoverFade);
      };

      if (coverImage?.complete) {
        updateCoverTone();
      } else {
        coverImage?.addEventListener("load", updateCoverTone, { once: true, signal: controller.signal });
        coverImage?.addEventListener("error", updateCoverTone, { once: true, signal: controller.signal });
      }

      updateCoverFade();
      window.addEventListener("scroll", requestCoverFade, { passive: true, signal: controller.signal });
      window.addEventListener("resize", () => {
        updateCoverTone();
        requestCoverFade();
      }, { signal: controller.signal });
    };

    document.addEventListener("astro:before-swap", () => cleanupWorkDetail());
    document.addEventListener("astro:page-load", initWorkDetail);
    initWorkDetail();
  </script>
</PublicLayout>
